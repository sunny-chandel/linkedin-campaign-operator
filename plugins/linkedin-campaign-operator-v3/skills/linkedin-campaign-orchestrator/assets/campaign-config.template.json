{
  "schema_version": "1.1",
  "campaign_id": "replace-me",
  "timezone": "UTC",
  "target": {
    "name": "10k-10k",
    "metric_a": {"name": "followers", "baseline": null, "goal": 10000},
    "metric_b": {"name": "connections", "baseline": null, "goal": 10000},
    "deadline": null,
    "completion_formula": "metric_a >= 10000 and metric_b >= 10000",
    "required_evidence": [
      "verified LinkedIn follower count",
      "verified LinkedIn connection count"
    ]
  },
  "audience": {
    "niche": "",
    "roles": [],
    "industries": [],
    "regions": ["india", "us-central", "uk-eu"],
    "exclusions": []
  },
  "content_pillars": [],
  "fixed_rules": {
    "posts_per_day": 2,
    "prepared_packages_per_content_day": 2,
    "max_actions_per_burst": 10,
    "base_actions_per_day": 100,
    "direct_reply_overage_allowed": true,
    "new_target_min_followers": 3000,
    "cooldown_hours": 72,
    "max_proactive_actions_per_person_per_7d": 2
  },
  "engagement_optimization": {
    "adaptive_fill": true,
    "minimum_action_score": 65,
    "weights": {
      "qualified_growth": 0.35,
      "audience_spillover": 0.2,
      "conversation_probability": 0.15,
      "target_relevance": 0.15,
      "freshness_timing": 0.1,
      "historical_performance": 0.05
    }
  },
  "adaptive_dispatch": {
    "enabled": true,
    "operating_span": "24h",
    "burst_gap_mode": "fully-adaptive",
    "wait_requires_empty_validated_queue": true,
    "reserve_mode": "adaptive-next-two-bursts",
    "soft_reciprocity_signals": [
      "like",
      "reaction",
      "follow",
      "profile-view",
      "connection-accepted"
    ],
    "direct_inbound_signals": ["comment", "reply", "direct-message"],
    "priority_order": [
      "platform-or-identity-blocker",
      "direct-inbound",
      "publication-opportunity",
      "mandatory-stage-recovery",
      "soft-reciprocity",
      "adaptive-reserve",
      "two-package-production",
      "analytics-and-investigation"
    ]
  },
  "publishing_optimization": {
    "mode": "fully-dynamic",
    "production_priority_window": {
      "start": "21:00",
      "end": "02:00",
      "timezone": "UTC"
    },
    "required_regions": ["india", "us-central"],
    "fixed_publish_times": [],
    "fixed_spacing_minutes": null,
    "dynamic_cannibalization_penalty": true,
    "no_extra_stockpile": true
  },
  "brand_system": {
    "auto_create": true,
    "auto_apply": true,
    "watermark_height_ratio": 0.06,
    "watermark_opacity": 0.85,
    "safe_area_inset_ratio": 0.04
  },
  "gif_creative_intelligence": {
    "enabled": true,
    "formats": ["gif"],
    "core_creator_count": 12,
    "rotating_creator_count": 8,
    "references_per_creator": 2,
    "dominant_score": 85,
    "dominant_margin": 15,
    "permanent_deletion": true
  },
  "subscription_optimization": {
    "enabled": true,
    "weights": {
      "campaign_relevance": 0.3,
      "unused_capacity": 0.25,
      "evidence_strength": 0.2,
      "expiry_urgency": 0.15,
      "implementation_readiness": 0.1
    },
    "thresholds": {
      "activate_now": 70,
      "schedule": 45
    },
    "purchases_allowed": false,
    "paid_plan_upgrades_allowed": false,
    "billing_changes_allowed": false,
    "paid_trial_starts_allowed": false
  }
}
